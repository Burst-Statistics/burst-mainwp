<?xml version="1.0"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.5/phpunit.xsd"
		 colors="true"
		 stopOnFailure="false"
		 verbose="true">

	<testsuites>
		<testsuite name="Burst MainWP Tests">
			<directory>tests/phpunit</directory>
		</testsuite>
	</testsuites>
</phpunit>
